{
    "folders": [
        {
            "name": "To The Future (Laravel+Inertia+Vue3)",
            "path": ".",
        },
    ],
    "settings": {
        // ===== CONFIGURAÇÕES ESPECÍFICAS DO WORKSPACE =====
        // Estas configurações se aplicam apenas a este workspace

        // ===== EDITOR =====
        "editor.formatOnSave": true,
        "editor.formatOnPaste": true,
        "editor.formatOnType": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.inlineSuggest.enabled": true,
        "editor.suggest.preview": true,
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit",
        },
        "editor.rulers": [120],
        "editor.wordWrap": "off",
        "workbench.colorTheme": "One Dark Pro Darker",
        "workbench.editor.enablePreview": false,
        "explorer.compactFolders": false,
        "explorer.confirmDelete": false,
        "window.title": "${dirty}${activeEditorShort}${separator}To The Future",
        "terminal.integrated.enableMultiLinePasteWarning": "never",

        // ===== ARQUIVOS =====
        "files.associations": {
            "*.vue": "vue",
            ".php-cs-fixer.php": "php",
            ".env*": "dotenv",
            "*.php": "php",
        },
        "files.exclude": {
            "**/node_modules": true,
            "**/vendor": false,
            "**/.git": true,
            "**/.DS_Store": true,
            "**/storage/logs": true,
            "**/storage/framework": true,
        },
        "search.exclude": {
            "**/node_modules": true,
            "**/vendor": true,
            "**/storage/logs": true,
            "**/storage/framework": true,
            "**/public/build": true,
        },

        // ===== FORMATAÇÃO E VUE =====
        "emmet.includeLanguages": {
            "vue": "html",
            "vue-html": "html",
        },
        "html.format.enable": true,
        "html.format.preserveNewLines": true,
        "html.format.maxPreserveNewLines": 2,
        "html.format.indentInnerHtml": true,
        "html.format.wrapAttributes": "preserve-aligned",
        "html.format.indentHandlebars": true,

        // ===== PRETTIER =====
        "prettier.tabWidth": 4,
        "prettier.useTabs": false,
        "prettier.semi": true,
        "prettier.singleQuote": true,
        "prettier.printWidth": 120,
        "prettier.trailingComma": "es5",
        "prettier.requireConfig": true,
        "prettier.useEditorConfig": false,
        "prettier.configPath": ".prettierrc.json",

        // ===== LINGUAGENS =====
        "[php]": {
            "editor.formatOnSave": true,
            "editor.formatOnType": true,
            "editor.formatOnPaste": true,
            "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
            "editor.codeActionsOnSave": {
                "source.fixAll": "explicit",
                "source.organizeImports": "explicit",
            },
            "files.insertFinalNewline": true,
            "files.trimTrailingWhitespace": true,
            "editor.rulers": [120],
            "editor.wordWrap": "off",
            "editor.tabSize": 4,
            "editor.insertSpaces": true,
            "editor.detectIndentation": false,
        },
        "[vue]": {
            "editor.formatOnSave": true,
            "editor.defaultFormatter": "esbenp.prettier-vscode",
            "editor.autoIndent": "full",
            "files.insertFinalNewline": true,
            "files.trimTrailingWhitespace": true,
            "editor.rulers": [120],
            "editor.wordWrap": "off",
            "editor.tabSize": 4,
            "editor.insertSpaces": true,
            "editor.detectIndentation": false,
        },
        "[javascript]": {
            "editor.formatOnSave": true,
            "editor.defaultFormatter": "esbenp.prettier-vscode",
            "editor.tabSize": 4,
            "editor.insertSpaces": true,
            "editor.codeActionsOnSave": {
                "source.fixAll.eslint": "explicit",
            },
        },
        "[typescript]": {
            "editor.formatOnSave": true,
            "editor.defaultFormatter": "esbenp.prettier-vscode",
            "editor.tabSize": 4,
            "editor.insertSpaces": true,
            "editor.codeActionsOnSave": {
                "source.fixAll.eslint": "explicit",
            },
        },
        "[json]": {
            "editor.formatOnSave": true,
            "editor.defaultFormatter": "esbenp.prettier-vscode",
        },
        "[jsonc]": {
            "editor.formatOnSave": true,
            "editor.defaultFormatter": "esbenp.prettier-vscode",
        },
        "[html]": {
            "editor.formatOnSave": true,
            "editor.defaultFormatter": "esbenp.prettier-vscode",
            "editor.tabSize": 4,
            "editor.insertSpaces": true,
        },
        "[css]": {
            "editor.formatOnSave": true,
            "editor.defaultFormatter": "esbenp.prettier-vscode",
        },
        "[scss]": {
            "editor.formatOnSave": true,
            "editor.defaultFormatter": "esbenp.prettier-vscode",
        },

        // ===== PHP / INTELEPHENSE (CONFIGURADO PARA USAR PHP DO CONTAINER + VENDOR MONTADO) =====
        "php.executablePath": "${workspaceFolder}/scripts/php-wrapper.sh",
        "php.validate.executablePath": "${workspaceFolder}/scripts/php-wrapper.sh",
        "php.validate.enable": false,
        "php.suggest.basic": false,

        "intelephense.format.enable": true,
        "intelephense.environment.phpVersion": "8.2.0",
        "intelephense.environment.documentRoot": "${workspaceFolder}/public",
        "intelephense.environment.includePaths": [
            "${workspaceFolder}/app",
            "${workspaceFolder}/bootstrap",
            "${workspaceFolder}/config",
            "${workspaceFolder}/database",
            "${workspaceFolder}/resources",
            "${workspaceFolder}/routes",
            "${workspaceFolder}/storage",
            "${workspaceFolder}/tests",
            "${workspaceFolder}/vendor",
            "${workspaceFolder}/_ide_helper.php",
        ],
        "intelephense.files.associations": ["*.php", "*.phtml"],
        "intelephense.files.exclude": [
            "**/.git/**",
            "**/node_modules/**",
            "**/storage/logs/**",
            "**/storage/framework/**",
            "**/public/build/**",
        ],
        "intelephense.stubs": [
            "Core",
            "standard",
            "SPL",
            "Reflection",
            "pcre",
            "bcmath",
            "bz2",
            "calendar",
            "ctype",
            "curl",
            "date",
            "dba",
            "dom",
            "enchant",
            "fileinfo",
            "filter",
            "ftp",
            "gd",
            "gettext",
            "hash",
            "iconv",
            "imap",
            "intl",
            "json",
            "ldap",
            "libxml",
            "zlib",
        ],
        "intelephense.files.maxSize": 10000000,
        "intelephense.completion.insertUseDeclaration": true,
        "intelephense.completion.fullyQualifyGlobalConstantsAndFunctions": false,
        "intelephense.format.braces": "per",
        "intelephense.phpdoc.useFullyQualifiedNames": true,
        "intelephense.diagnostics.enable": true,
        "intelephense.diagnostics.run": "onType",
        "intelephense.diagnostics.embeddedLanguages": true,
        "intelephense.diagnostics.undefinedSymbols": true,
        "intelephense.diagnostics.undefinedFunctions": true,
        "intelephense.diagnostics.undefinedConstants": true,
        "intelephense.diagnostics.undefinedClassConstants": true,
        "intelephense.diagnostics.undefinedMethods": true,
        "intelephense.diagnostics.undefinedProperties": true,
        "intelephense.diagnostics.undefinedTypes": true,
        "intelephense.diagnostics.undefinedVariables": false,
        "intelephense.diagnostics.unusedSymbols": false,
        "intelephense.references.exclude": ["**/node_modules/**"],
        "intelephense.rename.exclude": ["**/node_modules/**"],
        "intelephense.trace.server": "off",

        // ===== PHP CS FIXER =====
        "php-cs-fixer.executablePath": "${workspaceFolder}/scripts/php-cs-fixer.sh",
        "php-cs-fixer.config": "${workspaceFolder}/.php-cs-fixer.php",
        "php-cs-fixer.formatHtml": true,
        "php-cs-fixer.allowRisky": false,
        "php-cs-fixer.onsave": true,
        "php-cs-fixer.rules": "@PSR12",
        "php-cs-fixer.autoFixByBracket": true,
        "php-cs-fixer.autoFixBySemicolon": true,

        // ===== VUE + TYPESCRIPT CONFIGURAÇÕES =====
        "typescript.preferences.includePackageJsonAutoImports": "on",
        "typescript.suggest.autoImports": true,
        "typescript.inlayHints.parameterNames.enabled": "literals",
        "typescript.inlayHints.parameterTypes.enabled": false,
        "typescript.format.enable": false,
        "javascript.format.enable": false,

        "vue.autoInsert.dotValue": true,
        "vue.autoInsert.parentheses": true,
        "vue.codeActions.enabled": true,
        "vue.complete.casing.tags": "kebab",
        "vue.complete.casing.props": "camel",
        "vue.inlayHints.missingProps": true,
        "vue.inlayHints.inlineHandlerLeading": true,
        "vue.inlayHints.optionsWrapper": true,
        "vue.server.hybridMode": true,
        "vue.server.maxOldSpaceSize": 4096,
        "vue.server.runtime": "typescript",

        // ===== TERMINAL =====
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.confirmOnExit": "hasChildProcesses",
        "terminal.integrated.env.linux": {
            "COMPOSE_DOCKER_CLI_BUILD": "1",
        },

        // ===== DOCKER =====
        "docker.dockerPath": "docker",
        "docker.dockerComposePath": "docker-compose",
        "docker.enableDockerComposeLanguageService": true,

        // ===== GIT =====
        "git.enabled": true,
        "git.autofetch": true,

        // ===== SEGURANÇA =====
        "security.workspace.trust.untrustedFiles": "open",

        // ===== EXTENSÕES =====
        "extensions.autoUpdate": true,

        // ===== GITHUB COPILOT =====
        "github.copilot.enable": {
            "*": true,
            "scminput": false,
        },
        "chat.tools.terminal.autoApprove": {
            "allow": ["npm test", "npm run build", "git status"],
        },
        // Modelo automático otimizado
        // "github.copilot.chat.model": "auto",
        // Agent sessions visível
        // AGENTS.md ativo
        "chat.useAgentsMdFile": true,
        // Terminal seguro
        "chat.tools.terminal.enableAutoApprove": true,

        // Matemática em respostas
        // "chat.math.enabled": true,
        // Font customizada no chat
        "chat.fontFamily": "Fira Code",
        "chat.fontSize": 14,
        // Notificações de conclusão
        "chat.notifyWindowOnResponseReceived": true,
        "task.notifyWindowOnTaskCompletion": true,
        "github.copilot.inlineSuggest.enable": true,
        "github.copilot.editor.enableAutoCompletions": true,
        "github.copilot.chat.locale": "pt-BR",

        // ===== XDEBUG / PHP DEBUG (REQUER CONFIGURAÇÃO ADICIONAL) =====
        // NOTA: Para usar debug, é necessário instalar e configurar Xdebug no container
        // Para configurar: adicione Xdebug ao Dockerfile.dev e exponha a porta 9003
        "php.debug.executablePath": "${workspaceFolder}/scripts/php-wrapper.sh",
        "php.debug.port": [9003],

        // ===== EXTENSÕES ESPECÍFICAS =====

        // Auto Rename Tag
        "auto-rename-tag.activationOnLanguage": ["html", "xml", "php", "vue"],

        // Path Intellisense
        "path-intellisense.mappings": {
            "@": "${workspaceFolder}/resources",
            "~": "${workspaceFolder}/public",
        },

        // ESLint
        "eslint.workingDirectories": ["${workspaceFolder}"],
        "eslint.validate": ["javascript", "javascriptreact", "typescript", "vue"],

        // GitLens
        "gitlens.currentLine.enabled": false,
        "gitlens.hovers.currentLine.over": "line",
        "gitlens.codeLens.enabled": false,

        // Laravel Artisan (ryannaddy.laravel-artisan)
        "laravel_artisan.docker.enabled": true,
        "laravel_artisan.docker.command": "./scripts/artisan.sh",

        // Emmet para Vue
        "emmet.triggerExpansionOnTab": false,
        "emmet.showExpandedAbbreviation": "inMarkupAndStylesheetFilesOnly",

        // Configurações de performance
        "diffEditor.codeLens": true,
        "editor.minimap.enabled": true,
        "editor.minimap.showSlider": "mouseover",
        "workbench.reduceMotion": "on",
        "containers.containerCommand": "docker",
        "containers.enableComposeLanguageService": true,
    },
    "extensions": {
        "recommendations": [
            "github.copilot",
            "github.copilot-chat",
            "bmewburn.vscode-intelephense-client",
            "Vue.volar",
            "open-southeners.laravel-pint",
            "codingyu.laravel-goto-view",
            "barryvdh.laravel-ide-helper",
            "esbenp.prettier-vscode",
            "eamodio.gitlens",
            "ms-vscode.vscode-json",
            "DotJoshJohnson.xml",
            "junstyle.php-cs-fixer",
            "ryannaddy.laravel-artisan",
            "onecentlin.laravel-blade",
            "ms-azuretools.vscode-docker",
            "formulahendry.auto-rename-tag",
            "christian-kohler.path-intellisense",
            "bradlc.vscode-tailwindcss",
            "ms-vscode.vscode-typescript-next",
            "ms-vscode.vscode-eslint",
        ],
        "unwantedRecommendations": ["felixfbecker.php-intellisense"],
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Laravel: Start Development",
                "type": "shell",
                "command": "./start.sh",
                "args": ["dev"],
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "shared",
                },
                "problemMatcher": [],
            },
            {
                "label": "Laravel: Stop Development",
                "type": "shell",
                "command": "./start.sh",
                "args": ["stop"],
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "shared",
                },
                "problemMatcher": [],
            },
            {
                "label": "Laravel: Show Logs",
                "type": "shell",
