        ],
        "inputs": [
            {
                "id": "artisanCommand",
                "description": "Digite o comando Artisan",
                "default": "list",
                "type": "promptString",
            },
        ],
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "🐛 Listen for Xdebug (Requires Xdebug Setup)",
                "type": "php",
                "request": "launch",
                "port": 9003,
                "pathMappings": {
                    "/var/www/html": "${workspaceFolder}",
                },
                "log": true,
                "ignore": ["**/vendor/**/*.php"],
            },
            {
                "name": "🚀 Run Current PHP Script in Container",
                "type": "php",
                "request": "launch",
                "program": "${workspaceFolder}/scripts/php-wrapper.sh",
                "args": ["${file}"],
                "cwd": "${workspaceFolder}",
                "console": "integratedTerminal",
            },
            {
                "name": "🧪 Run Laravel Artisan Command",
                "type": "php",
                "request": "launch",
                "program": "${workspaceFolder}/scripts/artisan.sh",
                "args": ["${input:artisanCommand}"],
                "cwd": "${workspaceFolder}",
                "console": "integratedTerminal",
            },
        ],
    },
}
