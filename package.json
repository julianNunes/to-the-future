{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint --fix resources/js",
        "format": "prettier . --write",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:e2e:prepare": "rm -f public/hot && php artisan db:seed --class=E2ESmokeSeeder --force",
        "test:e2e": "npm run test:e2e:prepare && playwright test -c playwright.config.js",
        "test:e2e:ui": "npm run test:e2e:prepare && playwright test --ui -c playwright.config.js",
        "test": "npm run test:unit && npm run test:e2e"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.28.0",
        "@inertiajs/vue3": "^2.0",
        "@mdi/font": "^7.4.47",
        "@playwright/test": "^1.58.2",
        "@types/node": "^25.3.1",
        "@vue/test-utils": "^2.4.6",
        "@vitejs/plugin-vue": "^5.2.4",
        "axios": "^1.9.0",
        "esbuild": "^0.25.5",
        "eslint": "^9.28.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-prettier": "^5.4.1",
        "eslint-plugin-vue": "^10.1.0",
        "globals": "^16.2.0",
        "jsdom": "^26.1.0",
        "laravel-vite-plugin": "^1.3.0",
        "prettier": "3.5.3",
        "vite": "^6.3.5",
        "vite-plugin-eslint": "^1.8.1",
        "vite-plugin-vuetify": "^2.1.1",
        "vitest": "^3.2.4",
        "vue": "^3.5.16",
        "vuetify": "^3.8.7"
    },
    "dependencies": {
        "@date-io/moment": "^3.2.0",
        "apexcharts": "^4.7.0",
        "crypto-js": "^4.2.0",
        "file-saver": "^2.0.5",
        "moment": "^2.30.1",
        "read-excel-file": "^5.8.8",
        "update": "^0.7.4",
        "vue-i18n": "^11.1.5",
        "vue-toastification": "^2.0.0-rc.5",
        "vue3-apexcharts": "^1.8",
        "vuetify-money-3": "github:mibsbalsante/vuetify-money-3",
        "write-excel-file": "^2.3.2"
    }
}
