    "editor.formatOnSave": true,
    "editor.formatOnType": false,
    "editor.formatOnPaste": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.detectIndentation": false,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit"
    },
    
    "[php]": {
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.formatOnPaste": true,
        "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[javascript]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[typescript]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[vue]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[json]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[css]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[scss]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    
    "breadcrumbs.enabled": true,
    "workbench.statusBar.visible": true,
    "workbench.editor.enablePreview": false,
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "workbench.iconTheme": "vs-seti",
    
    "php.suggest.basic": true,
    "intelephense.maxMemory": 512,
    "intelephense.diagnostics.enable": true,
    "intelephense.diagnostics.run": "onSave",
    "intelephense.completion.triggerParameterHints": true,
    "intelephense.completion.insertUseDeclaration": true,
    "intelephense.format.enable": true,
    "intelephense.format.braces": "psr12",
    "intelephense.format.insertSpaces": true,
    "intelephense.format.tabSize": 4,
    
    "vue.autoInsert.dotValue": true,
    "vue.autoInsert.parentheses": true,
    "vue.codeActions.enabled": true,
    "vue.complete.casing.tags": "kebab",
    "vue.complete.casing.props": "camel",
    "vue.inlayHints.missingProps": true,
    "vue.inlayHints.inlineHandlerLeading": true,
    "vue.inlayHints.optionsWrapper": true,
    "vue.server.hybridMode": true,
    "vue.server.maxOldSpaceSize": 4096,
    "vue.server.runtime": "typescript",
    
    "typescript.preferences.includePackageJsonAutoImports": "on",
    "typescript.suggest.autoImports": true,
    "typescript.inlayHints.parameterNames.enabled": "literals",
    "typescript.inlayHints.parameterTypes.enabled": false,
    
    "files.associations": {
        "*.vue": "vue",
        "*.blade.php": "blade"
    },
    
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.gpuAcceleration": "auto",
    "terminal.integrated.smoothScrolling": false,
    
    "prettier.requireConfig": true,
    "prettier.useEditorConfig": false,
    "prettier.configPath": ".prettierrc.json",
    
    "emmet.includeLanguages": {
        "vue": "html", 
        "vue-html": "html"
    },
    "emmet.triggerExpansionOnTab": false,  // DESABILITADO - conflita com Copilot TAB
    "emmet.showExpandedAbbreviation": "inMarkupAndStylesheetFilesOnly",
    
    "github.copilot.enable": {
        "*": true,
        "yaml": true,
        "plaintext": false,
        "markdown": true
    },
    "github.copilot.editor.enableAutoCompletions": true,
    "github.copilot.advanced": {
        "debug.showScores": false,
        "debug.useElectronNetworking": true
    },
    "github.copilot.chat.experimental.codeGeneration.instructions": [
        "Always use 4 spaces for indentation",
        "Follow PSR-12 standards for PHP",
        "Use Laravel 10 best practices",
        "Prefer Vue 3 Composition API"
    ],
    "github.copilot.chat.locale": "pt-BR",
    
    "extensions.autoUpdate": false,
    "extensions.autoCheckUpdates": false,
    
    "settingsSync.enabled": false,
    "settingsSync.keybindingsPerPlatform": false
}
