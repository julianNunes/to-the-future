{
    "name": "To The Future (Dev Container)",

    // O caminho para o docker-compose.yml, relativo a este arquivo.
    // ".." significa "subir um nível", saindo da pasta .devcontainer.
    "dockerComposeFile": [
        "../docker-compose.yml"
    ],
    "service": "php",
    "workspaceFolder": "/var/www/html",

    "customizations": {
        "vscode": {
            "extensions": [
                // GitHub Copilot
                "GitHub.copilot",
                "GitHub.copilot-chat",

                // Essenciais para o desenvolvimento
                "bmewburn.vscode-intelephense-client", // IntelliSense para PHP
                "open-southeners.laravel-pint", // Formatador oficial do Laravel (Pint)
                "esbenp.prettier-vscode", // Formatador para JS, Vue, CSS, etc.
                "dbaeumer.vscode-eslint", // Linter para JS/Vue

                // Específicas para Laravel/Vue
                "amiralizadeh948.laravel-extra-intellisense", // Helpers para Laravel
                "Vue.volar", // Suporte oficial e moderno para Vue 3
                "Vue.vscode-typescript-vue-plugin", // TypeScript support para Vue

                // Docker
                "ms-azuretools.vscode-docker", // Suporte completo para Docker
                "ms-vscode-remote.remote-containers", // Remote Containers

                // Qualidade de vida
                "eamodio.gitlens", // Melhora a integração com o Git dentro do container
                "formulahendry.auto-rename-tag", // Auto rename HTML/Vue tags
                "christian-kohler.path-intellisense", // Path autocomplete
                "ms-vscode.vscode-json", // JSON support
                "redhat.vscode-yaml", // YAML support

                // Laravel específico
                "codingyu.laravel-goto-view", // Go to view from controller
                "ryannaddy.laravel-artisan", // Laravel Artisan commands

                // Debugging
                "xdebug.php-debug" // XDebug para PHP
            ],
            "settings": {
                // Configurações específicas para o Dev Container
                "terminal.integrated.defaultProfile.linux": "bash",
                "php.suggest.basic": false,
                "intelephense.files.maxSize": 5000000,
                "files.associations": {
                    "*.vue": "vue"
                },
                "emmet.includeLanguages": {
                    "vue": "html"
                },
                // Docker
                "docker.host": "unix:///var/run/docker.sock",
                "docker.dockerPath": "/usr/bin/docker",
                // Copilot
                "github.copilot.enable": {
                    "*": true,
                    "php": true,
                    "javascript": true,
                    "vue": true
                }
            }
        }
    },
    // Executa comandos após a criação do container.
    // Usa nosso script de setup personalizado para uma configuração mais robusta
    "postCreateCommand": "/var/www/html/.devcontainer/setup.sh",

    // Monta o socket do Docker para permitir uso de comandos Docker dentro do container
    "mounts": [
        "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
    ],

    // Variáveis de ambiente específicas para o Dev Container
    "containerEnv": {
        "DOCKER_BUILDKIT": "1",
        "COMPOSE_DOCKER_CLI_BUILD": "1"
    },    // Portas que devem ser encaminhadas
    "forwardPorts": [8080, 5173, 3307],
    "portsAttributes": {
        "8080": {
            "label": "Laravel App",
            "protocol": "http"
        },
        "5173": {
            "label": "Vite Dev Server",
            "protocol": "http"
        },
        "3307": {
            "label": "MySQL Database"
        }
    },
    // O usuário deve ser o mesmo criado dentro do seu Dockerfile.dev
    "remoteUser": "www-data"
}
