# Dockerfile.vite - Versão funcional para Dev Container
FROM node:20-alpine

WORKDIR /app

# Configuração básica do npm
RUN npm config set registry https://registry.npmjs.org/ && \
    npm config set cache /tmp/.npm && \
    npm config set prefer-offline false

# Copiar arquivos de dependências
COPY package*.json ./

# Instalar TODAS as dependências (desenvolvimento + produção)
RUN npm ci --silent

# Copiar código fonte
COPY . .

EXPOSE 5173

# Comando para Vite
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
