# Dockerfile.dev
FROM php:8.2-fpm-alpine

# Obtenha o UID e GID do usuário do host (por padrão, 1000)
# Isso é para compatibilidade ao montar volumes do host
ARG PUID=1000
ARG PGID=1000
ARG DOCKER_GID

# 1. Instala dependências do sistema, Docker CLI, e configura o usuário em uma única camada
RUN apk add --no-cache \
    # Utilitários de sistema e para o Docker
    sudo docker-cli docker-compose shadow netcat-openbsd \
    # Dependências para Node.js e NPM, necessárias para as ferramentas de front-end
    nodejs npm \
    # Navegador do sistema para Playwright em Alpine
    chromium nss harfbuzz ca-certificates ttf-freefont \
    # Dependências de runtime para extensões PHP
    libpng libjpeg-turbo freetype libzip \
    # Dependências de build para extensões PHP (serão removidas depois)
    libzip-dev oniguruma-dev libpng-dev libjpeg-turbo-dev freetype-dev \
    zip git curl bash \
    # Garante que um grupo com o GID do Docker do host exista.
    # Se o GID já estiver em uso, usa o grupo existente. Caso contrário, cria um novo grupo 'docker'.
    && DOCKER_GROUP_NAME=$(getent group $DOCKER_GID | cut -d: -f1) \
    && if [ -z "$DOCKER_GROUP_NAME" ]; then \
    DOCKER_GROUP_NAME=docker; \
    addgroup -g $DOCKER_GID $DOCKER_GROUP_NAME; \
    fi \
    # Configura o usuário www-data
    && if [ "$PUID" -ne "$(id -u www-data)" ]; then usermod -o -u "$PUID" www-data ; fi \
    && if [ "$PGID" -ne "$(id -g www-data)" ]; then groupmod -o -g "$PGID" www-data ; fi \
    && usermod -s /bin/bash www-data \
    && addgroup www-data $DOCKER_GROUP_NAME \
    # Concede ao usuário www-data permissão para executar QUALQUER comando com sudo sem senha.
    && echo "www-data ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers \
    # Compila as extensões PHP
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-configure zip \
    && docker-php-ext-install pdo pdo_mysql gd mbstring zip \
    # Limpa as dependências de build para manter a imagem final menor
    && apk del --no-network libzip-dev oniguruma-dev libpng-dev libjpeg-turbo-dev freetype-dev shadow

# 2. Instala Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# 3. Copia os manifestos de dependência para aproveitar o cache do Docker
COPY composer.json composer.lock ./
# Instala as dependências sem gerar o autoloader ou rodar scripts, para otimizar o cache.
RUN composer install --no-interaction --no-autoloader --no-scripts

# 4. Copia o código da aplicação
COPY . .

# 5. Gera o autoloader e roda os scripts agora que o código completo está presente.
RUN composer dump-autoload --optimize

# 6. Configura git e ajusta as permissões.
RUN git config --system --add safe.directory /var/www/html \
    && chown -R www-data:www-data /var/www/html

# 7. Instala o entrypoint-dev e dá permissão
COPY entrypoint-dev.sh /usr/local/bin/entrypoint-dev.sh
RUN chmod +x /usr/local/bin/entrypoint-dev.sh

USER www-data

ENTRYPOINT ["entrypoint-dev.sh"]
# php-fpm é o CMD default
