{
    "preset": "laravel",
    "rules": {
        "group_import": true,
        "ordered_imports": {
            "imports_order": ["class", "function", "const"],
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "single_import_per_statement": false,
        "array_indentation": true,
        "indentation_type": true
    },
    "indent": "    ",
    "exclude": [
        "vendor",
        "node_modules",
        "storage"
    ]
}
